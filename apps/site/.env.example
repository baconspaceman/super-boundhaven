# Copy to .env.local / .env.production and adjust.
# Where the "Play the prototype" button points (default: /play).
VITE_PLAY_URL=/play
# Waitlist endpoint that accepts POST JSON {email, displayName?, consent, source} (default: /api/waitlist).
# While no backend exists, leave it unset: the form honestly reports "sign-ups aren't connected yet".
# VITE_WAITLIST_URL=https://example.invalid/api/waitlist
